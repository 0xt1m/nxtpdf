# Normalize line endings; keep the repo LF, check out native on Windows.
* text=auto eol=lf

*.rs      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary assets — never diff or normalize.
*.png     binary
*.ico     binary
*.icns    binary
*.pdf     binary
*.dll     binary
*.so      binary
*.dylib   binary

# Lockfiles: keep in repo, collapse in diffs.
pnpm-lock.yaml   linguist-generated=true -diff
Cargo.lock       linguist-generated=true -diff
