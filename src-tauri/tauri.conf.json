{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NXTPDF",
  "version": "1.2.0",
  "identifier": "com.nxtpdf.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NXTPDF",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://nxtpdf.localhost nxtpdf://localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "lib/pdfium.dll": "pdfium.dll"
    },
    "copyright": "Copyright (c) 2026 NXTPDF contributors",
    "category": "Productivity",
    "shortDescription": "Simple PDF editing with real print control",
    "longDescription": "NXTPDF is a lightweight PDF editor: view and reorganize pages, fill and build forms, and print with full control over tray, duplex, and color.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/0xt1m/nxtpdf/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMkUzNDQ5Q0I1NEZEMzUKUldRMS9WVExTVFF1UGpsMDJhMnZSK1hCM2ZibFRtTGRoaXZ2VGIveENTR0hEK3RCWkJINjZQRG4K",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
